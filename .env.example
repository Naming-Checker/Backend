APP_NAME=Backend Service
APP_ENV=local
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# Browser manual testing from local static server (comma-separated origins). Omit or override in production.
# CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Elastic APM (disabled locally unless ELK + apm-server are running)
# ELASTIC_APM_ENABLED=true
# ELASTIC_APM_SERVER_URL=http://127.0.0.1:8200
# ELASTIC_APM_SERVICE_NAME=naming-check-backend
# ELASTIC_APM_ENVIRONMENT=local
# ELASTIC_APM_TRANSACTION_SAMPLE_RATE=1.0
