# Copy to .env.elk.local for local runs: cp .env.elk.example .env.elk.local
# On test stand this file is written by deploy from GitHub secret TEST_STAND_ELK_ENV_FILE.

STACK_VERSION=8.17.0
ELASTIC_PASSWORD=change-me-strong-password
# Public URL for Kibana (test stand deploy sets this from TEST_STAND_HOST).
KIBANA_PUBLIC_BASE_URL=http://127.0.0.1:5601
# Optional; Kibana connects to ES as kibana_system. Defaults to ELASTIC_PASSWORD.
# KIBANA_PASSWORD=change-me-strong-password
ES_JAVA_OPTS="-Xms512m -Xmx512m"
