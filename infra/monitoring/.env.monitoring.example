PROMETHEUS_RETENTION_TIME=7d
PROMETHEUS_RETENTION_SIZE=1GB
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-strong-password
# Deploy workflow sets this to http://<test-stand-host>:3000
GRAFANA_PUBLIC_BASE_URL=http://127.0.0.1:3000

# Alertmanager → Telegram (optional; without these alerts stay in Alertmanager UI only)
# Create bot via @BotFather, get chat_id via getUpdates API.
ALERTMANAGER_TELEGRAM_BOT_TOKEN=
ALERTMANAGER_TELEGRAM_CHAT_ID=
