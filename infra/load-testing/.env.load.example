# Load testing environment — copy to .env.load and adjust.
# Usage:
#   cp infra/load-testing/.env.load.example infra/load-testing/.env.load
#   bash scripts/load/prepare-load-test-env.sh

# Target API for k6 (required). Use internal Docker hostname on the test stand server.
LOAD_TEST_BASE_URL=http://naming-check-backend:8000

# URL for host-side health checks (optional). Auto-defaults to http://127.0.0.1:8000 when BASE_URL uses naming-check-backend.
# LOAD_TEST_VERIFY_URL=http://127.0.0.1:8000

# Comma-separated allowlist of hostnames/IPs k6 and scripts may target.
# Prevents accidental runs against unknown hosts.
LOAD_TEST_ALLOWED_HOSTS=localhost,127.0.0.1,naming-check-backend

# Optional: public test stand host (for remote k6 from a laptop).
# LOAD_TEST_STAND_HOST=203.0.113.10
# LOAD_TEST_BASE_URL=http://203.0.113.10:8000

# Load profile name (baseline | normal | peak | stress | soak) — used by k6 scripts.
LOAD_TEST_PROFILE=baseline

# Monitoring URLs (for the operator; k6 does not scrape these).
PROMETHEUS_URL=http://127.0.0.1:9090
GRAFANA_URL=http://127.0.0.1:3000

# k6 output (optional). Examples:
# K6_OUT=influxdb=http://influxdb:8086/k6
# K6_OUT=json=/tmp/k6-results.json
K6_OUT=

# Test data paths inside k6 container (mounted read-only).
K6_LOGO_FILE=/data/sample-logo.png
